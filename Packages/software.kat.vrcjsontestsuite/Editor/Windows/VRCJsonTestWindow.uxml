<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/software.kat.vrcjsontestsuite/Editor/Windows/VRCJsonTestWindow.uss?fileID=7433441132597879392&amp;guid=689832cb298150549b9f4870fa52fb53&amp;type=3#VRCJsonTestWindow" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(56, 56, 56); padding-top: 20px; padding-right: 10px; padding-bottom: 20px; padding-left: 10px;">
        <ui:Button text="Run Tests" parse-escape-sequences="true" display-tooltip-when-elided="true" name="run-tests-button" class="button text" style="margin-bottom: 22px;" />
        <ui:VisualElement name="result-names-container" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: stretch; max-height: 40px; min-height: 40px; height: 40px; align-self: auto;">
            <ui:VisualElement class="textBackground" style="flex-grow: 1; flex-basis: 1%; justify-content: center; align-items: flex-end; margin-right: 2px;">
                <ui:Label tabindex="-1" text=".NET Newtonsoft.Json 12.0.3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="result-1-name-text" class="text" style="align-items: flex-end; -unity-font-style: bold; padding-left: 2px;" />
            </ui:VisualElement>
            <ui:VisualElement class="textBackground" style="flex-grow: 1; flex-basis: 1%; align-items: flex-start; justify-content: center; margin-left: 2px;">
                <ui:Label tabindex="-1" text="VRCJSON 3.10.5-beta.1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="result-2-name-text" class="text" style="align-items: flex-start; -unity-font-style: bold; padding-left: 4px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="test-results-list" fixed-item-height="30" />
    </ui:VisualElement>
</ui:UXML>
