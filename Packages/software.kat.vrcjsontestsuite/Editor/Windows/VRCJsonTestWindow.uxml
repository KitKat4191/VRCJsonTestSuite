<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/software.kat.vrcjsontestsuite/Editor/Windows/VRCJsonTestWindow.uss?fileID=7433441132597879392&amp;guid=689832cb298150549b9f4870fa52fb53&amp;type=3#VRCJsonTestWindow" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(56, 56, 56); padding-top: 10px; padding-right: 10px; padding-bottom: 20px; padding-left: 10px;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 46px; max-height: 46px; min-height: 46px; margin-top: 2px; margin-right: 4px; margin-bottom: 6px; margin-left: 4px; flex-direction: row; justify-content: center; align-self: auto; align-items: stretch;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-basis: 1%; padding-right: 2px; justify-content: space-between; align-items: stretch; flex-direction: row;">
                <ui:Toggle label="Hide expected results" focusable="false" name="hide-expected-toggle" class="text toggle" style="flex-basis: auto; flex-grow: 1; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 0; align-items: center; padding-left: 5px; -unity-text-align: middle-center; -unity-font-style: bold; border-left-color: rgb(48, 48, 48); border-right-color: rgb(48, 48, 48); border-top-color: rgb(48, 48, 48); border-bottom-color: rgb(48, 48, 48); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;" />
                <ui:Toggle label="Hide undefined cases" focusable="false" name="hide-undefined-toggle" class="text toggle" style="flex-basis: auto; flex-grow: 1; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 2px; align-items: center; padding-left: 5px; -unity-text-align: middle-center; -unity-font-style: bold; border-left-color: rgb(48, 48, 48); border-right-color: rgb(48, 48, 48); border-top-color: rgb(48, 48, 48); border-bottom-color: rgb(48, 48, 48); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;" />
                <ui:Toggle label="Diff" focusable="false" name="diff-toggle" class="text toggle" style="flex-basis: auto; flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 2px; align-items: center; padding-left: 5px; -unity-text-align: middle-center; -unity-font-style: bold; border-left-color: rgb(48, 48, 48); border-right-color: rgb(48, 48, 48); border-top-color: rgb(48, 48, 48); border-bottom-color: rgb(48, 48, 48); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;" />
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 0.5; flex-basis: 1%; padding-left: 2px; flex-shrink: 0;">
                <ui:Button text="Re-run all tests" parse-escape-sequences="true" display-tooltip-when-elided="true" name="run-tests-button" class="button text" style="margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; justify-content: center; align-items: center; align-self: auto; flex-direction: row; flex-basis: 1%; flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="result-names-container" style="flex-grow: 1; flex-direction: row; justify-content: space-around; align-items: stretch; max-height: 40px; min-height: 40px; height: 40px; align-self: auto;">
            <ui:VisualElement class="textBackground" style="flex-grow: 1; flex-basis: 1%; justify-content: center; align-items: flex-end; margin-right: 2px;">
                <ui:Label tabindex="-1" text=".NET Newtonsoft.Json 12.0.3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="result-1-name-text" class="text" style="align-items: flex-end; -unity-font-style: bold; padding-left: 2px;" />
            </ui:VisualElement>
            <ui:VisualElement class="textBackground" style="flex-grow: 1; flex-basis: 1%; align-items: flex-start; justify-content: center; margin-left: 2px;">
                <ui:Label tabindex="-1" text="VRCJSON 3.10.5-beta.1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="result-2-name-text" class="text" style="align-items: flex-start; -unity-font-style: bold; padding-left: 4px;" />
                <ui:Label tabindex="-1" text="Showing 112/318" parse-escape-sequences="true" display-tooltip-when-elided="true" name="element-count-text" class="text" style="position: absolute; right: 0; bottom: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="test-results-list" fixed-item-height="34" style="margin-top: 2px;" />
    </ui:VisualElement>
</ui:UXML>
